# Copy to backend/.env and fill in your key.
GEMINI_API_KEY=

# Models (confirmed live on the hackathon endpoint).
IMAGE_MODEL=gemini-3.1-flash-lite-image
VIDEO_MODEL=gemini-omni-1.1-flash
MUSIC_MODEL=lyria-3.5
UTILITY_MODEL=gemini-3.8-flash
VOICE_MODEL=gemini-3.8-flash-tts
VOICE_NAME=Kore

# Fan-out concurrency (tune to measured rate limits).
IMAGE_CONCURRENCY=8
VIDEO_CONCURRENCY=4
MUSIC_CONCURRENCY=4

# Per-call timeouts (seconds).
IMAGE_TIMEOUT_S=60
VIDEO_TIMEOUT_S=600
MUSIC_TIMEOUT_S=120
VOICE_TIMEOUT_S=60

# Ad defaults locked across all markets.
AD_DURATION_S=6
AD_BPM=128
AD_ASPECT=16:9
# Omni's confirmed per-clip bounds — a request outside this range is rejected.
VIDEO_MIN_S=3
VIDEO_MAX_S=10

# Localized voiceover/narration, mixed over the background music.
ENABLE_VOICEOVER=true

# Optional Gemini-vision brand-consistency judge.
ENABLE_BRAND_JUDGE=false
